{
  "compilerOptions": {
    "types": [
      "mocha",
      "chai"
    ],
    "typeRoots": [
      "./node_modules/@types"
    ],
    "lib": [
      "es2015"
    ],
    "module": "commonjs",
    "target": "es6",
    "esModuleInterop": true,
    "resolveJsonModule": true,

    
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "strict": false,
    "rootDir": ".",
    "skipLibCheck": true

  }
}
